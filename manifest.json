{
  "schema": 4,
  "name": "neebles-proxy-client",
  "version": "1.0.2",
  "entrypoint": "runtime/neebles-proxy-client",
  "lifecycle": "lifecycle.json",
  "surfaces": "surfaces.json",
  "contracts": [],
  "settings": "settings/default.json",
  "uninstall": {
    "schema": 1,
    "hardcoded": {
      "config_bridge_service": "neebles-neebles-proxy-client-config-bridge.service"
    },
    "main": "governor",
    "extras": [
      {
        "id": "config-bridge-daemon",
        "type": "service",
        "provider": "systemd-user",
        "name": "$hardcoded.config_bridge_service",
        "exec_start": "/opt/neebles/modules/neebles-proxy-client/runtime/neebles-proxy-client --serve-config",
        "required": true,
        "stop": {
          "disable": true,
          "timeout_ms": 5000
        },
        "verify": "inactive",
        "remove": true
      }
    ],
    "cleanup": [
      {
        "id": "local-settings",
        "type": "settings",
        "ref": "manifest.settings",
        "policy": "user-choice"
      }
    ],
    "failure": {
      "unknown_process_owner": "abort",
      "resource_still_running": "abort",
      "cleanup_error": "abort"
    }
  },
  "platform_operations": "contracts/platform-operations.json",
  "other-label-open": true
}
